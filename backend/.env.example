# Application
APP_NAME=AI QA Agent POC
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite for local POC; swap DATABASE_URL for PostgreSQL later)
# SQLite example:
DATABASE_URL=sqlite:///./qa_agent.db
# PostgreSQL example (future):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/qa_agent

# LLM (provider-agnostic). `mock` or empty uses the deterministic mock client.
# The mock does not call an external model and does not need an API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
